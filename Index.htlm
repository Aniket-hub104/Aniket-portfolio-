<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aniket Tamang | Thunder Breathing Portfolio</title>

    <link rel="stylesheet" href="style.css">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
</head>

<body>

    <!-- Loader -->

    <div id="loader">
        <h1>THUNDER BREATHING...</h1>
        <p>Total Concentration</p>
    </div>

    <!-- Navbar -->

    <nav>
        <div class="logo">⚡ ANIKET</div>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#education">Education</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#hobbies">Hobbies</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Hero -->

    <section id="home" class="hero">

        <div class="hero-content">

            <h3>Thunder Breathing First Form</h3>

            <h1>
                ANIKET <br>
                TAMANG
            </h1>

            <h2>Student • AI Explorer • Creative Thinker</h2>

            <p>
                Pursuing B.A. at Surya Sen Mahavidyalaya while
                continuously learning technology, AI tools and
                digital creativity.
            </p>

            <div class="hero-buttons">
                <a href="#about" class="btn">Explore More</a>
                <a href="#contact" class="btn secondary">Contact Me</a>
            </div>

        </div>

        <div class="hero-image">
            <img src="images/zenitsu.png" alt="Zenitsu">
        </div>

    </section>

    <!-- About -->

    <section id="about" class="about">

        <h2 class="section-title">About Me</h2>

        <div class="about-container">

            <div class="about-img">
                <img src="images/profile.jpg" alt="Aniket">
            </div>

            <div class="about-text">

                <p>
                    Hello, I'm Aniket Tamang.
                </p>

                <p>
                    I am currently pursuing my Bachelor of Arts degree while balancing
                    my studies with a part-time job. Managing both responsibilities
                    has strengthened my discipline, time management and determination.
                </p>

                <p>
                    I enjoy learning AI tools, technology, web development,
                    animation, sketching, music and digital creativity.
                </p>

            </div>

        </div>

    </section>

    <!-- Education -->

    <section id="education" class="education">

        <h2 class="section-title">Education</h2>

        <div class="edu-card">

            <h3>Surya Sen Mahavidyalaya</h3>

            <h4>Bachelor of Arts (B.A. Pass)</h4>

            <p>Currently Pursuing Graduation</p>

            <p>
                Balancing academics with part-time work while
                continuously building new skills.
            </p>

        </div>

    </section>

    <!-- Skills -->

    <section id="skills">

        <h2 class="section-title">Skills</h2>

        <div class="skill-grid">

            <div class="card">HTML</div>
            <div class="card">CSS</div>
            <div class="card">JavaScript</div>
            <div class="card">Git & GitHub</div>
            <div class="card">AI Tools</div>
            <div class="card">Problem Solving</div>
            <div class="card">Creativity</div>
            <div class="card">Communication</div>

        </div>

    </section>

    <!-- Hobbies -->

    <section id="hobbies">

        <h2 class="section-title">Hobbies</h2>

        <div class="hobby-grid">

            <div class="card">🎸 Guitar</div>
            <div class="card">🎤 Singing</div>
            <div class="card">✏ Sketching</div>
            <div class="card">🤖 AI Tools</div>
            <div class="card">🎞 Animation</div>
            <div class="card">📺 Anime</div>
            <div class="card">🎬 Movies</div>
            <div class="card">🎧 Music</div>

        </div>

    </section>

    <!-- Projects -->

    <section id="projects">

        <h2 class="section-title">Completed Missions</h2>

        <div class="project-grid">

            <div class="project-card">
                <h3>Portfolio Website</h3>
                <p>Personal Portfolio Project</p>
            </div>

            <div class="project-card">
                <h3>Weather App</h3>
                <p>Real Time Weather Project</p>
            </div>

            <div class="project-card">
                <h3>Calculator App</h3>
                <p>JavaScript Based Calculator</p>
            </div>

            <div class="project-card">
                <h3>Future Project</h3>
                <p>Coming Soon</p>
            </div>

        </div>

    </section>

    <!-- Contact -->

    <section id="contact">

        <h2 class="section-title">Contact Me</h2>

        <div class="contact-box">

            <p>
                <i class="fa-solid fa-envelope"></i>
                bunnytamang635@gmail.com
            </p>

            <p>
                <i class="fa-solid fa-phone"></i>
                8389029238
            </p>

            <p>
                <i class="fa-brands fa-github"></i>
                github.com/aniket-hub104
            </p>

        </div>

    </section>

    <!-- Footer -->

    <footer>

        <p>
            "Growth comes from continuous learning,
            discipline and the courage to keep moving forward."
        </p>

        <h4>© 2026 Aniket Tamang</h4>

    </footer>

    <script src="script.js"></script>

</body>

</html>
